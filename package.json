{
  "name": "vs-flat",
  "displayName": "VS Flat",
  "description": "Flat themes based on the built-in Visual Studio themes",
  "version": "0.0.1",
  "publisher": "megumichai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/megumichai/vscode-theme-vs-flat.git"
  },
  "homepage": "https://github.com/megumichai/vscode-theme-vs-flat#readme",
  "bugs": {
    "url": "https://github.com/megumichai/vscode-theme-vs-flat/issues"
  },
  "license": "MIT",
  "scripts": {
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "publish:openvsx": "ovsx publish -i vs-flat-*.vsix",
    "sort:json": "node scripts/sort-json.mjs"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "VS Flat Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/dark.json"
      },
      {
        "label": "VS Flat Light",
        "uiTheme": "vs",
        "path": "./themes/light.json"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "^4.1.1",
    "ovsx": "^1.4.0"
  }
}
